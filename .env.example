# ========================================================
# HRX Enterprise Monorepo Environment Variables
# ========================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database (Local MongoDB or MongoDB Atlas)
# Local: mongodb://localhost:27017/hrx_dev
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hrx_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://hrx_admin:admin091@m0.lbs0dih.mongodb.net/?appName=M0&compressors=zlib

# JWT Cryptographic Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_character_hex_string_access
JWT_REFRESH_SECRET=replace_with_a_secure_random_64_character_hex_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://hrx-web.vercel.app

# Organization Default Settings
ORG_TIMEZONE=Asia/Kolkata
ORG_LATE_THRESHOLD_MINUTES=15

# Cloudinary Private Document Storage (Optional: falls back to local uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API Key (Optional: falls back to deterministic local AI provider)
GEMINI_API_KEY=
