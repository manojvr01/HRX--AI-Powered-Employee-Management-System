# HRX Monorepo Environment Variables Example
# Copy to apps/api/.env and apps/web/.env as needed

# ==========================================
# Backend (apps/api/.env)
# ==========================================
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/hrx_dev
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Authentication JWT
JWT_ACCESS_SECRET=hrx_super_secret_access_jwt_key_min_32_chars_long_12345
JWT_REFRESH_SECRET=hrx_super_secret_refresh_jwt_key_min_32_chars_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Organization Default Settings
ORG_TIMEZONE=Asia/Kolkata
ORG_LATE_THRESHOLD_MINUTES=15

# Logging
LOG_LEVEL=info

# Demo Seed Credentials (Development Only)
# Default seed password for all demo accounts: Password123!
# Admin: admin@hrx.local
# HR: hr@hrx.local
# Manager: manager@hrx.local
# Employee: employee@hrx.local

# Optional External Services
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ==========================================
# Frontend (apps/web/.env)
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=HRX
